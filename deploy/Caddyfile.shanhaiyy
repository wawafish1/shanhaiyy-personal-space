# Personal space — canonical HTTPS domain
shanhaiyy.xyz {
    encode zstd gzip
    reverse_proxy personal-space-site:80
}

www.shanhaiyy.xyz {
    redir https://shanhaiyy.xyz{uri} permanent
}

# Keep direct-IP HTTP access as an operational fallback.
http://43.108.22.156 {
    encode zstd gzip
    reverse_proxy personal-space-site:80
}
